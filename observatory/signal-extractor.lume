/// TRUTH Observatory — Signal Extractor + History Backfill daemon
/// DarkWave Studios LLC — Copyright 2026
///
/// Collectors keep raw source files for only a few hours. Every 10 minutes
/// this daemon reads the newest raw file of each product, pulls out the real
/// physical values (not file sizes), and writes hourly/daily rows and
/// geolocated events into the permanent Signal Store (lib/signal-store).
///
/// On first boot (and resumably after restarts) it also loads public history:
///   - GFZ Potsdam Kp / sunspot number / F10.7       (1932 onward)
///   - NASA OMNI2 hourly solar wind, IMF, Dst, AE,
///     proton flux                                    (1963 onward)
///   - USGS ComCat earthquakes M4.5+                  (1973 onward)
///   - this Observatory's own archived manifests       (seismic, wildfire, volcanic)
/// History never overwrites live rows (onlyMissing).
///
/// DDA 42-Doctrine mapping:
///   [02] Boundary Engine    → reads raw/ and manifests; writes only signals/
///   [08] Temporal Engine    → all keys UTC; current partial hour never written
///   [09] Reference Engine   → every series sourced per lib/signal-catalog
///   [14] Determinacy Engine → same source file → same rows (idempotent upserts)
///   [22] Continuity Layer   → per-product and per-backfill-unit progress persisted
///   [35] Collapse Detection → one failed product/unit never stops the others
///   [40] Non-Being Guard    → fill values (9999, -1, null) are dropped, never stored

use { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync, renameSync, statSync, unlinkSync } from "node:fs"
use { join } from "node:path"
use { execFileSync } from "node:child_process"
use { attempt, tryParse, put, iso } from "./lib/lume-shim.mjs"
use { readSince } from "./lib/manifest-ledger.mjs"
use { aggregate, hourKey, dayKey, utcMs, tidy, upsertSeries, upsertEvents, signalsRoot } from "./lib/signal-store.mjs"

let STATE_DIR = process.env.STATE_DIR or "/app/state/observatory"
let RAW_DIR = process.env.RAW_DIR or join(STATE_DIR, "raw")
let ROOT = signalsRoot(STATE_DIR)
let STATE_FILE = join(ROOT, "extractor-state.json")
let TMP_DIR = join(ROOT, ".tmp")
let TICK_MS = 600000
let OMNI_FIRST_YEAR = Number(process.env.SIGNALS_OMNI_FROM or 1963)
let QUAKE_FIRST_YEAR = Number(process.env.SIGNALS_QUAKES_FROM or 1973)
let REFRESH_MS = 7 * 86400000
let ALL_HISTORY_HOURS = 1000000

// ── State ───────────────────────────────────────────────────────────────────
to loadState():
    if not existsSync(STATE_FILE):
        return { version: 1, processed: {}, backfill: {} }
    let st = tryParse(readFileSync(STATE_FILE, "utf8"))
    if st == null:
        return { version: 1, processed: {}, backfill: {} }
    return st

to saveState(st):
    mkdirSync(ROOT, { recursive: true })
    Object.assign(st, { savedAt: iso(Date.now()) })
    let tmp = STATE_FILE + ".tmp"
    writeFileSync(tmp, JSON.stringify(st, null, 2))
    renameSync(tmp, STATE_FILE)

// ── Raw file discovery ──────────────────────────────────────────────────────
to walk(dir, out):
    let names = attempt(makeLister(dir), [])
    for each name in names:
        let p = join(dir, name)
        let s = attempt(makeStat(p), null)
        if s == null:
            continue
        if s.isDirectory():
            walk(p, out)
        else:
            out.push({ name: name, path: p, mtime: s.mtimeMs })
    return out

to makeLister(dir):
    to go() -> readdirSync(dir)
    return go

to makeStat(p):
    to go() -> statSync(p)
    return go

to newestFor(files, prefix):
    let best = null
    for each f in files:
        let hit = f.name.startsWith(prefix + "-") or f.name.startsWith(prefix + "_")
        if hit and f.name.endsWith(".json"):
            if best == null or f.mtime > best.mtime:
                set best to f
    return best

to readJson(path):
    to go() -> JSON.parse(readFileSync(path, "utf8"))
    return attempt(go, null)

// ── Helpers ─────────────────────────────────────────────────────────────────
to num(v):
    if v == null or v == "":
        return NaN
    return Number(v)

/// Rows for complete hours only (the current hour is still filling).
to completeHours(rows, nowMs):
    let current = hourKey(nowMs)
    to done(r) -> r[0] < current
    return rows.filter(done)

/// SWPC JSON comes either as objects or as arrays with a header row.
to recordsOf(j):
    if not Array.isArray(j) or j.length == 0:
        return []
    if not Array.isArray(j[0]):
        return j
    let header = j[0]
    let out = []
    let i = 1
    while i < j.length:
        let rec = {}
        let c = 0
        while c < header.length:
            put(rec, header[c], j[i][c])
            set c to c + 1
        out.push(rec)
        set i to i + 1
    return out

to isActive(r) -> r.active == true

// ── Live product parsers: each returns a count of rows written ───────────────
to writeHourly(id, points, nowMs):
    return upsertSeries(STATE_DIR, id, completeHours(aggregate(points, hourKey), nowMs), false)

to parseKp(j, nowMs):
    let pts = []
    for each r in recordsOf(j):
        let v = num(r.Kp)
        if Number.isNaN(v):
            set v to num(r.kp_index)
        pts.push([utcMs(r.time_tag), v])
    // Kp rows are keyed to their 3-hour start; the in-progress interval is
    // SWPC's running estimate and is replaced as it updates.
    return upsertSeries(STATE_DIR, "kp", aggregate(pts, hourKey), false)

to parseXray(j, nowMs):
    let pts = []
    for each r in recordsOf(j):
        if r.energy == "0.1-0.8nm":
            pts.push([utcMs(r.time_tag), num(r.flux)])
    return writeHourly("xray_long", pts, nowMs)

to parseProtons(j, nowMs):
    let pts = []
    for each r in recordsOf(j):
        if r.energy == ">=10 MeV":
            pts.push([utcMs(r.time_tag), num(r.flux)])
    return writeHourly("proton10", pts, nowMs)

to parsePlasma(j, nowMs):
    let recs = recordsOf(j)
    if recs.length == 0 or recs[0].proton_speed == null:
        return 0
    let speed = []
    let dens = []
    for each r in recs.filter(isActive):
        let t = utcMs(r.time_tag)
        speed.push([t, num(r.proton_speed)])
        dens.push([t, num(r.proton_density)])
    return writeHourly("sw_speed", speed, nowMs) + writeHourly("sw_density", dens, nowMs)

to parseMag(j, nowMs):
    let recs = recordsOf(j)
    if recs.length == 0 or recs[0].bt == null:
        return 0
    let bz = []
    let bt = []
    for each r in recs.filter(isActive):
        let t = utcMs(r.time_tag)
        let z = num(r.bz_gsm)
        if Number.isNaN(z):
            set z to num(r.bz_gse)
        bz.push([t, z])
        bt.push([t, num(r.bt)])
    return writeHourly("imf_bz", bz, nowMs) + writeHourly("imf_bt", bt, nowMs)

to parseDst(j, nowMs):
    let pts = []
    for each r in recordsOf(j):
        pts.push([utcMs(r.time_tag), num(r.dst)])
    return upsertSeries(STATE_DIR, "dst", aggregate(pts, hourKey), false)

to parseGoesMag(j, nowMs):
    let pts = []
    for each r in recordsOf(j):
        if r.arcjet_flag != true:
            pts.push([utcMs(r.time_tag), num(r.Hp)])
    return writeHourly("goes_hp", pts, nowMs)

/// USGS geomag JSON: minute X component → |dX/dt| in nT/min.
to makeGeomagParser(seriesId):
    to parse(j, nowMs):
        if j == null or j["times"] == null or j["values"] == null:
            return 0
        let times = j["times"]
        let xs = null
        for each comp in j["values"]:
            if comp.id == "X":
                set xs to comp["values"]
        if xs == null:
            return 0
        let pts = []
        let i = 1
        while i < times.length:
            let a = xs[i - 1]
            let b = xs[i]
            let ta = Date.parse(times[i - 1])
            let tb = Date.parse(times[i])
            if a != null and b != null and tb - ta == 60000:
                pts.push([tb, Math.abs(b - a)])
            set i to i + 1
        return writeHourly(seriesId, pts, nowMs)
    return parse

to parseFlares(j, nowMs):
    let evs = []
    for each r in recordsOf(j):
        if r.max_class != null and r.begin_time != null:
            evs.push({ id: "flare-" + r.begin_time, t: r.max_time or r.begin_time, cls: r.max_class, peak: tidy(num(r.max_xrlong)), begin: r.begin_time, end: r.end_time or null, satellite: r.satellite })
    return upsertEvents(STATE_DIR, "flare", evs, false)

to parseWildfireRaw(j, nowMs):
    if j == null or j.fires == null:
        return 0
    let evs = []
    for each f in j.fires:
        let id = f.irwinId or (f.name + "|" + f.discoveredAt)
        if f.discoveredAt != null and f.lat != null and f.lon != null:
            evs.push({ id: id, t: iso(Date.parse(f.discoveredAt)), lat: f.lat, lon: f.lon, name: f.name, state: f.state, acres: f.acres, cause: f.cause or null })
    return upsertEvents(STATE_DIR, "wildfire", evs, false)

to isElevated(level) -> level != null and level != "NORMAL" and level != "UNASSIGNED"

to parseVolcanicRaw(j, nowMs):
    if j == null or j.volcanoes == null:
        return 0
    let evs = []
    for each v in j.volcanoes:
        if isElevated(v.alertLevel) and v.alertDate != null:
            let t = utcMs(v.alertDate)
            if not Number.isNaN(t):
                evs.push({ id: v.name + "|" + v.alertLevel + "|" + iso(t), t: iso(t), lat: v.lat, lon: v.lon, name: v.name, region: v.region, level: v.alertLevel, color: v.colorCode })
    return upsertEvents(STATE_DIR, "volcano", evs, false)

// Product prefix → parser. Order matters only for log readability.
let PRODUCTS = []
PRODUCTS.push({ prefix: "planetary-k", parse: parseKp })
PRODUCTS.push({ prefix: "xray-flux", parse: parseXray })
PRODUCTS.push({ prefix: "particle-flux", parse: parseProtons })
PRODUCTS.push({ prefix: "solar-wind-plasma", parse: parsePlasma })
PRODUCTS.push({ prefix: "solar-wind-mag", parse: parseMag })
PRODUCTS.push({ prefix: "dst", parse: parseDst })
PRODUCTS.push({ prefix: "swpc-mag-1m", parse: parseGoesMag })
PRODUCTS.push({ prefix: "usgs-bou", parse: makeGeomagParser("geomag_bou") })
PRODUCTS.push({ prefix: "usgs-frd", parse: makeGeomagParser("geomag_frd") })
PRODUCTS.push({ prefix: "usgs-brw", parse: makeGeomagParser("geomag_brw") })
PRODUCTS.push({ prefix: "usgs-hon", parse: makeGeomagParser("geomag_hon") })
PRODUCTS.push({ prefix: "flare-events", parse: parseFlares })
PRODUCTS.push({ prefix: "wildfire", parse: parseWildfireRaw })
PRODUCTS.push({ prefix: "volcanic", parse: parseVolcanicRaw })
to parseDemand(j, nowMs):
    if j == null or j.response == null or not Array.isArray(j.response.data):
        return 0
    let pts = []
    for each r in j.response.data:
        if r.respondent == "US48" and r.type == "D" and r.value != null:
            let period = String(r.period)
            let tStr = period + ":00:00Z"
            if period.length != 13:
                set tStr to period
            let t = Date.parse(tStr)
            let v = num(r.value)
            if not Number.isNaN(t) and not Number.isNaN(v):
                pts.push([t, v])
    return upsertSeries(STATE_DIR, "grid_demand_us", aggregate(pts, hourKey), false)
PRODUCTS.push({ prefix: "demand", parse: parseDemand })

// ── Manifest-derived signals (survive raw pruning) ──────────────────────────
to quakeOf(e):
    let t = Date.parse(e.originTime)
    if Number.isNaN(t) or e.eventId == null:
        return null
    return { id: e.eventId, t: iso(t), lat: e.latitude, lon: e.longitude, depth: e.depthKm, mag: e.magnitude, magType: e.magnitudeType or null, place: e.place or null }

to fromSeismicManifest(hours):
    let evs = []
    for each e in readSince(STATE_DIR, "seismic-manifest.jsonl", hours):
        if e["type"] == "EARTHQUAKE-EVENT":
            let q = quakeOf(e)
            if q != null:
                evs.push(q)
    return upsertEvents(STATE_DIR, "quake", evs, false)

to dailyFromManifest(file, field, seriesId, hours):
    let pts = []
    for each e in readSince(STATE_DIR, file, hours):
        if e["type"] == "OBSERVATION" and e[field] != null:
            pts.push([Date.parse(e.retrievedAt), num(e[field])])
    return upsertSeries(STATE_DIR, seriesId, aggregate(pts, dayKey), false)

to fromManifests(hours):
    let n = fromSeismicManifest(hours)
    set n to n + dailyFromManifest("wildfire-manifest.jsonl", "activeFires", "wildfire_active", hours)
    set n to n + dailyFromManifest("wildfire-manifest.jsonl", "totalAcres", "wildfire_acres", hours)
    set n to n + dailyFromManifest("volcanic-manifest.jsonl", "elevatedCount", "volcano_elevated", hours)
    return n

// ── Live cycle ──────────────────────────────────────────────────────────────
to extractLive(st):
    let nowMs = Date.now()
    let files = walk(RAW_DIR, [])
    let written = 0
    for each p in PRODUCTS:
        let f = newestFor(files, p.prefix)
        if f == null:
            continue
        if st.processed[p.prefix] == f.mtime:
            continue
        let j = readJson(f.path)
        if j == null:
            continue
        let parse = p.parse
        to run() -> parse(j, nowMs)
        let n = attempt(run, -1)
        if n < 0:
            show "[SIGNALS] {p.prefix}: parse failed ({f.name})"
            continue
        put(st.processed, p.prefix, f.mtime)
        set written to written + n
    let m = attempt(makeManifestRun(48), -1)
    if m > 0:
        set written to written + m
    saveState(st)
    show "[SIGNALS] live cycle: {written} rows/events written"
    return written

to makeManifestRun(hours):
    to go() -> fromManifests(hours)
    return go

// ── History backfill ────────────────────────────────────────────────────────
to download(url, name):
    mkdirSync(TMP_DIR, { recursive: true })
    let dest = join(TMP_DIR, name)
    to go():
        execFileSync("curl", ["-sfL", "--retry", "3", "--retry-delay", "5", "--max-time", "900", "-o", dest, url])
        return dest
    return attempt(go, null)

to removeQuietly(p):
    to go() -> unlinkSync(p)
    attempt(go, null)

to isNonEmpty(s) -> s.length > 0

/// GFZ "Kp_ap_Ap_SN_F107_since_1932.txt": YYYY MM DD days days_m Bsr dB Kp1..Kp8 ap1..ap8 Ap SN F10.7obs F10.7adj D
to backfillGfz(st):
    if st.backfill.gfzAt != null and Date.now() - Date.parse(st.backfill.gfzAt) < REFRESH_MS:
        return 0
    let path = download("https://kp.gfz-potsdam.de/app/files/Kp_ap_Ap_SN_F107_since_1932.txt", "gfz.txt")
    if path == null:
        show "[SIGNALS] GFZ download failed — will retry next boot/refresh"
        return 0
    let kp = []
    let sn = []
    let f107 = []
    for each line in readFileSync(path, "utf8").split("\n"):
        if line.startsWith("#") or line.trim().length == 0:
            continue
        let c = line.trim().split(" ").filter(isNonEmpty)
        if c.length < 27:
            continue
        let day = c[0] + "-" + c[1] + "-" + c[2]
        let k = 0
        while k < 8:
            let v = num(c[7 + k])
            if v >= 0:
                let hh = String(k * 3).padStart(2, "0")
                kp.push([day + "T" + hh, v, v, v, 1])
            set k to k + 1
        let s = num(c[24])
        if s >= 0:
            sn.push([day, s, s, s, 1])
        let fl = num(c[25])
        if fl > 0:
            f107.push([day, fl, fl, fl, 1])
    removeQuietly(path)
    let n = upsertSeries(STATE_DIR, "kp", kp, true) + upsertSeries(STATE_DIR, "sunspots", sn, true) + upsertSeries(STATE_DIR, "f107", f107, true)
    put(st.backfill, "gfzAt", iso(Date.now()))
    saveState(st)
    show "[SIGNALS] GFZ history: {kp.length} Kp, {sn.length} sunspot, {f107.length} F10.7 rows read; {n} new"
    return n

/// OMNI2 hourly words (1-based): 1 yr, 2 doy, 3 hr, 9 |B|, 17 Bz GSM, 24 Np, 25 V,
/// 39 Kp*10, 41 Dst, 42 AE, 46 proton flux >10 MeV. Fill values differ per word.
to omniKey(yr, doy, hr) -> iso(Date.UTC(yr, 0, doy, hr)).slice(0, 13)

to omniValue(c, idx, fill):
    let v = num(c[idx])
    if Number.isNaN(v) or v >= fill:
        return null
    return v

to pushRow(rows, k, v):
    if v != null:
        rows.push([k, v, v, v, 1])

to backfillOmniYear(y):
    let path = download("https://spdf.gsfc.nasa.gov/pub/data/omni/low_res_omni/omni2_" + String(y) + ".dat", "omni_" + String(y) + ".dat")
    if path == null:
        return -1
    let bt = []
    let bz = []
    let np = []
    let vel = []
    let dst = []
    let ae = []
    let pr = []
    for each line in readFileSync(path, "utf8").split("\n"):
        let c = line.trim().split(" ").filter(isNonEmpty)
        if c.length < 46:
            continue
        let k = omniKey(Number(c[0]), Number(c[1]), Number(c[2]))
        pushRow(bt, k, omniValue(c, 8, 999.9))
        pushRow(bz, k, omniValue(c, 16, 999.9))
        pushRow(np, k, omniValue(c, 23, 999.9))
        pushRow(vel, k, omniValue(c, 24, 9999.0))
        pushRow(dst, k, omniValue(c, 40, 99999.0))
        pushRow(ae, k, omniValue(c, 41, 9999.0))
        pushRow(pr, k, omniValue(c, 45, 99999.0))
    removeQuietly(path)
    let n = upsertSeries(STATE_DIR, "imf_bt", bt, true) + upsertSeries(STATE_DIR, "imf_bz", bz, true) + upsertSeries(STATE_DIR, "sw_density", np, true)
    set n to n + upsertSeries(STATE_DIR, "sw_speed", vel, true) + upsertSeries(STATE_DIR, "dst", dst, true) + upsertSeries(STATE_DIR, "ae", ae, true) + upsertSeries(STATE_DIR, "proton10", pr, true)
    return n

to backfillOmni(st):
    let done = st.backfill.omniYears or {}
    let thisYear = Number(iso(Date.now()).slice(0, 4))
    let total = 0
    let y = OMNI_FIRST_YEAR
    while y <= thisYear:
        let key = String(y)
        let recent = y >= thisYear - 1
        let stale = recent and (st.backfill.omniRefreshAt == null or Date.now() - Date.parse(st.backfill.omniRefreshAt) > REFRESH_MS)
        if done[key] != true or stale:
            let n = backfillOmniYear(y)
            if n >= 0:
                put(done, key, true)
                put(st.backfill, "omniYears", done)
                saveState(st)
                set total to total + n
                show "[SIGNALS] OMNI {key}: {n} new rows"
            else:
                show "[SIGNALS] OMNI {key}: download failed — will retry"
        set y to y + 1
    put(st.backfill, "omniRefreshAt", iso(Date.now()))
    saveState(st)
    return total

to quakeUrl(fromDay, toDay) -> "https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&minmagnitude=4.5&orderby=time-asc&limit=20000&starttime=" + fromDay + "&endtime=" + toDay

to featureToQuake(f):
    let p = f.properties
    let g = f.geometry
    if p == null or g == null or p.time == null:
        return null
    return { id: f.id, t: iso(p.time), lat: g.coordinates[1], lon: g.coordinates[0], depth: g.coordinates[2], mag: p.mag, magType: p.magType or null, place: p.place or null }

to fetchQuakes(fromDay, toDay, name):
    let path = download(quakeUrl(fromDay, toDay), name)
    if path == null:
        return null
    let j = readJson(path)
    removeQuietly(path)
    if j == null or j.features == null:
        return null
    let evs = []
    for each f in j.features:
        let q = featureToQuake(f)
        if q != null:
            evs.push(q)
    return evs

to backfillQuakeYear(y):
    let a = String(y) + "-01-01"
    let mid = String(y) + "-07-01"
    let b = String(y + 1) + "-01-01"
    let evs = fetchQuakes(a, b, "quakes_" + String(y) + ".json")
    if evs == null:
        return -1
    if evs.length >= 20000:
        let h1 = fetchQuakes(a, mid, "quakes_" + String(y) + "a.json")
        let h2 = fetchQuakes(mid, b, "quakes_" + String(y) + "b.json")
        if h1 == null or h2 == null:
            return -1
        set evs to h1.concat(h2)
    return upsertEvents(STATE_DIR, "quake", evs, y < thisYear)

to backfillQuakes(st):
    let done = st.backfill.quakeYears or {}
    let thisYear = Number(iso(Date.now()).slice(0, 4))
    let total = 0
    let y = QUAKE_FIRST_YEAR
    while y <= thisYear:
        let key = String(y)
        let recent = y == thisYear
        let stale = recent and (st.backfill.quakeRefreshAt == null or Date.now() - Date.parse(st.backfill.quakeRefreshAt) > REFRESH_MS)
        if done[key] != true or stale:
            let n = backfillQuakeYear(y)
            if n >= 0:
                put(done, key, true)
                put(st.backfill, "quakeYears", done)
                saveState(st)
                set total to total + n
                show "[SIGNALS] quakes {key}: {n} new"
            else:
                show "[SIGNALS] quakes {key}: download failed — will retry"
        set y to y + 1
    put(st.backfill, "quakeRefreshAt", iso(Date.now()))
    saveState(st)
    return total

to backfillManifests(st):
    if st.backfill.manifestsAt != null:
        return 0
    let n = fromManifests(ALL_HISTORY_HOURS)
    put(st.backfill, "manifestsAt", iso(Date.now()))
    saveState(st)
    show "[SIGNALS] own manifest history: {n} rows/events"
    return n

to makeStep(fn, st):
    to go() -> fn(st)
    return go

to runBackfill(st):
    show "[SIGNALS] history backfill check…"
    let steps = [backfillManifests, backfillGfz, backfillOmni, backfillQuakes]
    for each fn in steps:
        let r = attempt(makeStep(fn, st), -1)
        if r < 0:
            show "[SIGNALS] a backfill step failed — continuing; it resumes next run"
    put(st.backfill, "checkedAt", iso(Date.now()))
    saveState(st)
    show "[SIGNALS] history backfill check complete"

// ── Entrypoint ──────────────────────────────────────────────────────────────
mkdirSync(ROOT, { recursive: true })
let STATE = loadState()

show "═══════════════════════════════════════════════════════════════"
show " TRUTH Observatory — Signal Extractor"
show " Raw: {RAW_DIR}"
show " Store: {ROOT}"
show "═══════════════════════════════════════════════════════════════"

to tick():
    let r = attempt(makeStep(extractLive, STATE), -1)
    if r < 0:
        show "[SIGNALS] live cycle failed — will retry next tick"
    let last = STATE.backfill.checkedAt
    if last == null or Date.now() - Date.parse(last) > REFRESH_MS:
        runBackfill(STATE)

tick()
if process.env.SIGNALS_ONCE == "1":
    process.exit(0)
setInterval(tick, TICK_MS)
