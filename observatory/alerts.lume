/// TRUTH Observatory — Email alert rules (opt-in)
/// DarkWave Studios LLC — Copyright 2026
///
/// Pure, deterministic functions. No network, no database, no clock reads:
/// the caller (server.mjs) passes in the data and the current time, and sends
/// whatever this module decides. Same inputs always yield the same outputs.
///
/// Categories a subscriber can switch on or off independently:
///   weather  → NWS warnings at their ZIP, at or above a chosen severity
///   brief    → the daily brief, once a day at the subscriber's local 7am
///   quakes   → earthquakes at or above a chosen magnitude
///   space    → geomagnetic storm level G3 or higher
///   volcano  → US volcanoes raised above NORMAL alert level
///
/// DDA 42-Doctrine mapping:
///   [14] Determinacy Engine → same inputs, same decision, no hidden state
///   [35] Safety Envelope    → per-user daily cap; nothing sends without opt-in
///   [40] Non-Being Guard    → no matching event means no email, never filler

use { localHour, localDay, clip, escHtml } from "./lib/lume-shim.mjs"

let SEVERITY_RANK = { Minor: 1, Moderate: 2, Severe: 3, Extreme: 4 }
let MIN_TO_RANK = { moderate: 2, severe: 3, extreme: 4 }
let MAX_PER_DAY = 12
let SMS_MAX_PER_DAY = 4
let BRIEF_LOCAL_HOUR = 7
let SMS_TAG = "Truth Observatory: "
let SMS_STOP = " Reply STOP to opt out."

/// Rank of an NWS severity word. Unknown severities rank 0 and never send.
to severityRank(sev):
    let r = SEVERITY_RANK[sev]
    if r == null:
        return 0
    return r

/// NWS alerts at or above the subscriber's minimum, as { key, alert } pairs.
export to pickWeather(alerts, minLevel):
    let floor = MIN_TO_RANK[minLevel] or 3
    let out = []
    for each a in alerts or []:
        if severityRank(a.severity) is at least floor:
            out.push({ key: "wx:" + a.id, alert: a })
    return out

/// Quakes at or above the subscriber's magnitude threshold.
export to pickQuakes(quakes, minMag):
    let out = []
    for each q in quakes or []:
        if q.mag is at least minMag:
            out.push({ key: "eq:" + q.id, quake: q })
    return out

/// Volcanoes at WATCH or WARNING (USGS). A change of alert level is a new key, so a
/// volcano that moves from ADVISORY to WATCH sends once more, not repeatedly.
export to pickVolcanoes(volcanoes):
    let out = []
    for each v in volcanoes or []:
        let lvl = v.alertLevel
        if lvl == "WATCH" or lvl == "WARNING":
            out.push({ key: "vo:" + v.name + ":" + lvl, volcano: v })
    return out

/// Geomagnetic storm: one key per scale level per UTC day.
export to pickSpace(gScale, dayKey):
    if gScale is at least 3:
        return [{ key: "sw:G" + gScale + ":" + dayKey, scale: gScale }]
    return []

/// True once per local day: at or after 7am in the subscriber's timezone.
export to briefDue(nowMs, tz):
    return localHour(nowMs, tz) is at least BRIEF_LOCAL_HOUR

export to briefKey(nowMs, tz) -> "brief:" + localDay(nowMs, tz)

/// How many more emails this subscriber may receive today.
export to remainingToday(sentToday) -> Math.max(0, MAX_PER_DAY - sentToday)

/// How many more text messages this subscriber may receive today.
export to smsRemainingToday(sentToday) -> Math.max(0, SMS_MAX_PER_DAY - sentToday)

export to smsMaxPerDay() -> SMS_MAX_PER_DAY

// ── Rendering ───────────────────────────────────────────────────────────────
to shell(title, bodyHtml, manageUrl, unsubUrl):
    let page = "<!doctype html><html><body style=\"margin:0;background:#0a0a0a;font-family:Helvetica,Arial,sans-serif;color:#e8e8e8\">"
    set page to page + "<div style=\"max-width:560px;margin:0 auto;padding:28px 20px\">"
    set page to page + "<div style=\"font-size:11px;letter-spacing:2px;color:#9a9a9a;text-transform:uppercase\">Truth Observatory</div>"
    set page to page + "<h1 style=\"font-size:20px;line-height:1.3;margin:10px 0 18px;color:#ffffff\">" + escHtml(title) + "</h1>"
    set page to page + bodyHtml
    set page to page + "<hr style=\"border:0;border-top:1px solid #2a2a2a;margin:28px 0 14px\">"
    set page to page + "<p style=\"font-size:12px;color:#8a8a8a;line-height:1.6;margin:0\">You are getting this because you turned on email alerts in your cockpit. "
    set page to page + "<a href=\"" + escHtml(manageUrl) + "\" style=\"color:#cfcfcf\">Change what you receive</a> &middot; "
    set page to page + "<a href=\"" + escHtml(unsubUrl) + "\" style=\"color:#cfcfcf\">Unsubscribe with one click</a></p>"
    set page to page + "</div></body></html>"
    return page

to footerText(manageUrl, unsubUrl):
    return "\n\n--\nYou turned on email alerts in your Truth Observatory cockpit.\nChange what you receive: " + manageUrl + "\nUnsubscribe: " + unsubUrl + "\n"

to para(s) -> "<p style=\"font-size:15px;line-height:1.6;margin:0 0 14px;color:#d8d8d8\">" + escHtml(s) + "</p>"

export to weatherMail(a, placeLabel, links):
    let subject = a.event + " — " + placeLabel
    let lines = [a.headline, "Area: " + a.areaDesc]
    if a.expires:
        lines.push("Expires: " + a.expires)
    if a.instruction:
        lines.push("What the National Weather Service says to do: " + clip(a.instruction, 600))
    else if a.description:
        lines.push(clip(a.description, 600))
    lines.push("Source: National Weather Service. Official instructions always override anything here.")
    let html = ""
    for each l in lines:
        set html to html + para(l)
    return { subject: subject, html: shell(a.event, html, links.manage, links.unsub), plain: lines.join("\n\n") + footerText(links.manage, links.unsub) }

export to quakeMail(q, links):
    let subject = "M" + q.mag + " earthquake — " + q.place
    let lines = ["Magnitude " + q.mag + ", " + q.place + ".", "Time: " + q.time, "Source: USGS. Magnitudes are often revised in the first hour."]
    let html = ""
    for each l in lines:
        set html to html + para(l)
    return { subject: subject, html: shell("M" + q.mag + " earthquake", html, links.manage, links.unsub), plain: lines.join("\n\n") + footerText(links.manage, links.unsub) }

export to spaceMail(scale, links):
    let subject = "Geomagnetic storm level G" + scale
    let lines = ["NOAA reports geomagnetic storm level G" + scale + " (scale runs G1 to G5).", "Higher levels can affect radio, GPS accuracy and power grids. Aurora may be visible farther south than usual.", "Source: NOAA Space Weather Prediction Center."]
    let html = ""
    for each l in lines:
        set html to html + para(l)
    return { subject: subject, html: shell(subject, html, links.manage, links.unsub), plain: lines.join("\n\n") + footerText(links.manage, links.unsub) }

export to volcanoMail(v, links):
    let subject = v.name + " — alert level " + v.alertLevel
    let lines = [v.name + " is at alert level " + v.alertLevel + ".", "Source: USGS Volcano Hazards Program."]
    let html = ""
    for each l in lines:
        set html to html + para(l)
    return { subject: subject, html: shell(subject, html, links.manage, links.unsub), plain: lines.join("\n\n") + footerText(links.manage, links.unsub) }

to isNonBlank(x) -> x.trim().length > 0

export to briefMail(headline, bodyText, links):
    let subject = "Your daily brief — " + headline
    let paras = String(bodyText or "").split("\n").filter(isNonBlank)
    let html = ""
    for each p in paras:
        set html to html + para(p)
    return { subject: subject, html: shell(headline, html, links.manage, links.unsub), plain: paras.join("\n\n") + footerText(links.manage, links.unsub) }

export to testMail(placeLabel, links):
    let lines = ["This is a test. Email alerts are on for " + placeLabel + ".", "Nothing else is sent unless an event matches what you chose. If this email reached you, the setup works."]
    let html = ""
    for each l in lines:
        set html to html + para(l)
    return { subject: "Test — Truth Observatory email alerts", html: shell("Email alerts are on", html, links.manage, links.unsub), plain: lines.join("\n\n") + footerText(links.manage, links.unsub) }

// ── Text messages (SMS) ─────────────────────────────────────────────────────
// Short, plain, branded, and every one carries the STOP instruction.
// The daily brief is email only and never goes out by text.

export to weatherSms(a, placeLabel):
    return SMS_TAG + clip(a.event, 60) + " for " + clip(placeLabel, 50) + ". Source: National Weather Service. Follow official instructions." + SMS_STOP

export to quakeSms(q):
    return SMS_TAG + "M" + q.mag + " earthquake, " + clip(q.place, 70) + ". Source: USGS." + SMS_STOP

export to spaceSms(scale):
    return SMS_TAG + "NOAA reports geomagnetic storm level G" + scale + " (scale G1-G5). Source: NOAA SWPC." + SMS_STOP

export to volcanoSms(v):
    return SMS_TAG + clip(v.name, 50) + " is at alert level " + v.alertLevel + ". Source: USGS." + SMS_STOP

/// Sent once, right after a subscriber opts in on the website.
export to smsConfirm():
    return SMS_TAG + "You are signed up for text alerts for the alert types in your account. Msg frequency varies, up to " + SMS_MAX_PER_DAY + "/day. Msg & data rates may apply. Reply HELP for help, STOP to opt out."
